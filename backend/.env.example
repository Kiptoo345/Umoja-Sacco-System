# Copy this file to .env and fill in your own values
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=umoja_sacco_db
JWT_SECRET=change-this-to-a-long-random-string
# Flat interest rate (percent) passed to the ApproveLoanApplication procedure
INTEREST_RATE=10
# Development only: return the password-reset token in the response (no email service yet)
RETURN_RESET_TOKEN=true
